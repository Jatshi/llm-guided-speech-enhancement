{
  "schema_version": "light.passport.v1",
  "project": "LLM-Guided Speech Enhancement 2.0",
  "stage": "gpu-full-chain-running",
  "entrypoints": {
    "preflight": "scripts/autodl_v2_preflight.sh",
    "bootstrap": "scripts/autodl_v2_bootstrap.sh",
    "run": "scripts/autodl_v2_run.sh"
  },
  "modes": ["smoke", "full"],
  "training_stages": ["sft", "dpo", "grpo"],
  "deepspeed": {
    "version": "0.16.3",
