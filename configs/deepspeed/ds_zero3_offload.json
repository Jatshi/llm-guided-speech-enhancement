{
  "_portfolio_contract": {
    "declared_world_size": 1,
    "single_gpu_only": true,
    "single_gpu_note": "world_size=1 has no cross-GPU sharding benefit. ZeRO-3 CPU offload is a memory-for-throughput trade and must be benchmarked against no-DeepSpeed and ZeRO-2."
  },
  "bf16": {
    "enabled": "auto"
  },
  "fp16": {
    "enabled": "auto"
  },
  "gradient_accumulation_steps": "auto",
  "gradient_clipping": "auto",
  "steps_per_print": 20,
  "train_batch_size": "auto",
  "train_micro_batch_size_per_gpu": "auto",
  "wall_clock_breakdown": true,
  "zero_optimization": {
    "stage": 3,
    "allgather_bucket_size": 100000000,
    "contiguous_gradients": true,
    "offload_optimizer": {
      "device": "cpu",
      "pin_memory": true
    },
    "offload_param": {
      "device": "cpu",
      "pin_memory": true
    },
    "overlap_comm": true,
    "reduce_bucket_size": 100000000,
    "stage3_gather_16bit_weights_on_model_save": true,
    "stage3_max_live_parameters": 100000000,
    "stage3_max_reuse_distance": 100000000,
    "stage3_prefetch_bucket_size": 50000000,
    "sub_group_size": 100000000
  }
}

