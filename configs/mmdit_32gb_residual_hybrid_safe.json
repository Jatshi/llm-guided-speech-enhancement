{
  "schema_version": "lse.mmdit.config.v1",
  "project": {"name": "lse-prescription-mmdit-32gb-residual-hybrid-safe", "root": "..", "seed": 42},
  "data": {"manifest": "data/mmdit/pairs.hybrid_safe_predictions.jsonl", "sample_rate": 16000, "segment_seconds": 2.0, "check_files": true},
  "codec": {"n_fft": 512, "hop_length": 128, "win_length": 512, "normalized": true, "scale": 16.0},
  "model": {"in_channels": 2, "model_dim": 384, "depth": 8, "heads": 8, "mlp_ratio": 4.0, "patch_frequency": 16, "patch_time": 8, "prescription_tokens": 8, "prescription_vocab": 1024, "field_vocab": 64, "dropout": 0.0, "gradient_checkpointing": false},
  "flow": {"steps": 8, "prescription_dropout": 0.15, "x0_l1_weight": 0.1, "guidance_scale": 1.0, "source_mode": "observed", "mismatch_noop_weight": 0.5},
